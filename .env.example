# Public Supabase API URL for browser and server requests
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public Supabase Anon Key (safe for browser with Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only Supabase Service Role Key (NEVER expose to browser; used for administrative operations)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Server-only Google Gemini API Key for story tag extraction, red-flag moderation, and embeddings
GEMINI_API_KEY=your-gemini-api-key
